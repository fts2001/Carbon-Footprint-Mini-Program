var convertTrackStamp = function (stamp, type) {
  if (stamp !== 0 && !stamp) {
    return "（记录提前终止）";
  }

  // 直接使用 UTC 时间，不需要调整时区偏移
  var time = getDate(stamp);
  var hour = time.getUTCHours(); // 使用 UTC 小时
  var minutes = time.getUTCMinutes(); // 使用 UTC 分钟
  var secondes = time.getUTCSeconds(); // 使用 UTC 秒

  // 格式化时间为两位数
  hour = hour < 10 ? "0" + hour : hour;
  minutes = minutes < 10 ? "0" + minutes : minutes;
  secondes = secondes < 10 ? "0" + secondes : secondes;

  return hour + ":" + minutes + ":" + secondes;
};

var convertStamp = function (stamp, type) {
  if (stamp !== 0 && !stamp) {
    return "（记录提前终止）";
  }
  if (type == "duration") {
    // 获取当前时区偏移（单位：分钟）
    var timezoneOffsetMinutes = getDate().getTimezoneOffset();
    // 将分钟偏移转换为毫秒（注意符号相反）
    var timezoneOffsetMilliseconds = -timezoneOffsetMinutes * 60 * 1000;
    stamp = stamp - timezoneOffsetMilliseconds;
  }
  var time = getDate(stamp);
  // var year = time.getFullYear()
  var month = time.getMonth() + 1;
  var date = time.getDate();
  var hour = time.getHours() < 10 ? "0" + time.getHours() : time.getHours();
  var minutes = time.getMinutes() < 10 ? "0" + time.getMinutes() : time.getMinutes();
  var secondes = time.getSeconds() < 10 ? "0" + time.getSeconds() : time.getSeconds();
  if (type == "duration") return hour + ":" + minutes + ":" + secondes;
  // else return year+"年"+month+"月"+date+"日 "+hour+":"+minutes+":"+secondes
  else return month + "月" + date + "日 " + hour + ":" + minutes + ":" + secondes;
};

var classPicker = function (list, index) {
  if (index === 0) {
    return "new listItem";
  } else {
    return "old listItem";
  }
};

var getTransportImage = function (calcTransport) {
  var transports = [
    { label: "步行/跑步", value: "../../asset/img/walking.svg" },
    { label: "骑行", value: "../../asset/img/bike.svg" },
    { label: "汽车(市区)", value: "../../asset/img/car.svg" },
    { label: "汽车(高速公路)", value: "../../asset/img/car.svg" },
    { label: "公交车（市区）", value: "../../asset/img/bus.svg" },
    { label: "公交车（长途）", value: "../../asset/img/bus.svg" },
    { label: "地铁", value: "../../asset/img/subway.svg" },
    { label: "高铁", value: "../../asset/img/train.svg" }
  ];

  var transport = null;

  for (var i = 0; i < transports.length; i++) {
    if (transports[i].label === calcTransport) {
      transport = transports[i];
      break;
    }
  }

  return transport ? transport.value : "../../asset/img/walking.svg";
};

var getActiveClassName = function (arr, label) {
  return arr.indexOf(label) !== -1 ? "active" : "";
};

module.exports.convertTrackStamp = convertTrackStamp;
module.exports.convertStamp = convertStamp;
module.exports.classPicker = classPicker;
module.exports.getTransportImage = getTransportImage;
module.exports.getActiveClassName = getActiveClassName;
