<!-- 新的注册页面 -->
<view style="height: 100vh;">
  <!-- 授权页面的背景图片 -->
  <image src="cloud://iluvcarb-0gzvs45g82b57f98.696c-iluvcarb-0gzvs45g82b57f98-1315168954/loginBackground/background1.png" style="position: fixed;left: 0;top: 0;width: 100vw;height: 100vh; z-index: 2;" wx:if="{{loginType === 0}}" bindload="showAuthorizeDialog" />
  <image src="cloud://iluvcarb-0gzvs45g82b57f98.696c-iluvcarb-0gzvs45g82b57f98-1315168954/loginBackground/background2.png" style="position: fixed;left: 0;top: 0;width: 100vw;height: 100vh; z-index: 2;" wx:if="{{loginType === 1}}" bindload="showAuthorizeDialog" />

  <!-- 提示弹窗 -->
  <van-dialog use-slot title="即将申请权限" show="{{ authorizeDialog }}" overlay="{{false}}" bind:confirm="getAuthorize" class="authorizeDialog">
    <view style="padding: 20rpx; text-align: center;line-height: 60rpx;">

      <block wx:if="{{loginType === 0}}">
        <view>依据网信办要求，需获取您的数据以完成碳排放计算及公共碳足迹监测， 请您授权：</view>
        <view>实时位置权限用于行程记录</view>
        <view>微信运动步数权限用于出行方式分析</view>
        <view>消息通知权限用于行程记录消息通知</view>
      </block>
      <block wx:else>
        <view>为优化对您的服务体验， 精准计算碳排放， 申请您的授权：</view>
        <view>实时位置权限用于实时定位记录绿色出行轨迹</view>
        <view>微信运动步数权限用于同步微信步数计算减排量</view>
        <view>消息通知权限用于开通通知接收积分到账提醒</view>
      </block>
      <view>拒绝给出权限不会影响后续抽奖</view>
    </view>
  </van-dialog>

  <!-- 模拟消息订阅的弹窗 -->
  <van-popup show="{{ showPopup }}" position="bottom" custom-style="height: 26%;" bind:close="onClosePopup" style="position: relative;">
    <view style="padding: 50rpx 30rpx 30rpx;background: #ededed;height: 100%;">
      <view style="display: flex; align-items: center;">
        <image src="cloud://iluvcarb-0gzvs45g82b57f98.696c-iluvcarb-0gzvs45g82b57f98-1315168954/logo/WechatIMG778.jpg" style="width: 50rpx;height: 50rpx;border-radius: 50%;margin-right: 20rpx;" />
        <text style="font-size: 28rpx;">碳行家 申请</text>
      </view>
      <view style="padding-top: 60rpx;">需要获取消息通知权限</view>
      <view class="authorizeBtn">
        <view bind:tap="onClosePopup">拒绝</view>
        <view bind:tap="submitSimulateAuthorize">允许</view>
      </view>
    </view>
  </van-popup>

  <!-- 知情同意书 -->
  <view>
    <modal title="知情同意" confirm-text="同意" cancel-text="取消" hidden="{{modalHidden}}" bindconfirm="modalConfirm" bindcancel="modalCancel">
      <scroll-view scroll-y="true" style="height:300px ; text-align: center;">
        <text>\n隐私声明

          一、前言\n

          欢迎使用“碳行家”，这是一款专注于个人碳足迹可视化的小程序。作为开发者，我们深知信息安全的重要性。此声明旨在帮助您了解我们如何收集、使用、存储和保护您的个人信息。\n

          二、信息收集\n

          本小程序在运行过程中收集的位置信息数据均为匿名采集。实验结束后，我们将全部销毁。在任何情况下，我们都不会将采集到的信息提供给任何第三方。\n

          三、合规性\n

          本小程序已经昆山杜克大学研究伦理委员会审查通过，符合学术研究规范要求。\n

          四、遵守规定\n

          本小程序严格遵守微信小程序开发、运营规则，确保所有活动操作在合法、规范的范围内进行。\n

          五、咨询与反馈\n

          如您对我们的隐私声明有任何疑问或需要提供任何反馈，欢迎随时与我们联系。\n
          联系方式：yucen.xiao@dukekunshan.edu.cn \n

          感谢您的信任，我们会竭尽全力守护信息安全。
        </text>
      </scroll-view>
    </modal>
  </view>

  <!-- 注册弹窗1 -->
  <van-dialog
    style="position: relative;"
    custom-style="background-color: transparent;"
    use-slot width="100vw" show="{{ newUserModalShow }}" show-confirm-button="{{false}}">
        <view style="height: 100rpx;">
          <image class="close-icon" src="../../asset/img/close.svg" bind:tap="closeNewUserModal" />
        </view>
        <view class="van-dialog-body">
            <image class="new-user-image" mode="widthFix" src="../../asset/img/new-user-modal.png" />
        </view>
    </van-dialog>

  <!-- 注册弹窗2 -->
  <van-dialog
    style="position: relative;"
    custom-style="background-color: transparent;"
    use-slot width="100vw" show="{{ newUserModalShow2 }}" show-confirm-button="{{false}}">
        <view class="van-dialog-body" style="display: flex; flex-direction: column; position: relative">
            <image class="new-user-image" mode="widthFix" src="../../asset/img/new-user-modal2.png" bind:tap="accept"/>
            <View style="font-weight: 600; font-size: 60rpx; color:#FF0000; position: absolute; left: 50%; top: 390rpx; transform: translateX(-50%);">0.03元</View>
            <view style="margin-top: 16rpx; padding: 20rpx 32rpx; background-color: #FCDB8E;font-size: 40rpx; color:#FF0000;width: 80vw; border-radius: 52rpx;">本次实验时间为期3天，每日登陆活跃领积分即可参与现金大转盘，领88元现金红包！</view>
        </view>
    </van-dialog>

      <!-- 完成注册积分提示弹窗 -->
  <van-dialog use-slot title="恭喜你完成了注册" show="{{ scoreTipsDialog }}" bind:confirm="getLoginType" class="authorizeDialog">
    <view style="padding: 20rpx; text-align: center;line-height: 60rpx;">
        <view>1.奖励触发方式:</view>
        <view>具体每次奖励积分值请以活动页面实际显示为准。</view>
        <view>2.积分兑换规则: </view>
        <view>您所获得的积分可以累积。</view>
        <view>最低积分兑换比例: 50积分=0.5元。</view>
        <view>积分可用于兑换红包或其他奖励，具体兑换方式请留意平台内的“积分好礼”界面。</view>
        <view>3.活动参与资格: </view>
        <view>通常需要完成注册/登录后方可参与本活动并累积积分。</view>
    </view>
  </van-dialog>

  <!-- 入口选择题 -->
  <view>
    <view style="color: #FFF;background:#419f8c; font-size: 40rpx;text-align: center;line-height: 90rpx;height: 90rpx;">
      注册
    </view>
    <scroll-view scroll-y style="height: calc(100vh - 90rpx);">

      <view class='itemClass'>
        <text>您的性别: </text>
        <radio-group class="radio-group" bindchange="newChange" data-name="sex">
          <label class="radio" wx:for="{{sexArr}}" wx:key="index">
            <radio value="{{item.name}}" />{{item.value}}
          </label>
        </radio-group>
      </view>

      <view class='itemClass'>
        <text>您的年龄: </text>
        <radio-group class="radio-group" bindchange="newChange" data-name="age">
          <label class="radio" wx:for="{{ageArr}}" wx:key="index">
            <radio value="{{item}}" />{{item}}
          </label>
        </radio-group>
      </view>

      <view class='itemClass'>
        <text>您的最高学历: </text>
        <radio-group class="radio-group" bindchange="newChange" data-name="grad">
          <label class="radio" wx:for="{{gradArr}}" wx:key="index">
            <radio value="{{item}}" />{{item}}
          </label>
        </radio-group>
      </view>

      <view class='itemClass'>
        <text>您的职业: </text>
        <radio-group class="radio-group" bindchange="newChange" data-name="occupation">
          <label class="radio" wx:for="{{occupationArr}}" wx:key="index">
            <radio value="{{item}}" />{{item}}
          </label>
        </radio-group>
      </view>

      <view class='itemClass2'>
        <text>请问您的月均收入(税前)属于以下哪个范围? </text>
        <view style="height: 15rpx;"></view>
        <radio-group class="radio-group" bindchange="newChange" data-name="income">
          <label class="radio" wx:for="{{incomeArr}}" wx:key="index">
            <radio value="{{item}}" />{{item}}
          </label>
        </radio-group>
      </view>

      <view>
        <text class="finish" bind:tap="showScoreTips">完成注册</text>
      </view>

    </scroll-view>
  </view>
</view>