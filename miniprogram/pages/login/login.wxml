          <image class="avatar" src="{{avatarUrl}}"></image>
        </button>
      </view>

      <view class="name">
        <text>昵称</text>
        <input type="nickname" placeholder-style="color:white" placeholder="此处输入昵称" name="nickname" bindinput="bindnamechange" value="{{ nickname }}" />
      </view>

