 <view class="name">
 <text>联系方式（选填）</text>
  <input type="text" placeholder-style="color:white" placeholder="用于奖品发放" name = "email" bindinput="bindemailchange" value="{{ email }}"/> 
 </view>
 
<view class='baseInfo'>
  <text>出行方式</text>
</view>

<view class='sex'>
    <text>始发地</text>
    <picker bindchange="bindRegionChange" value = "{{region}}" mode = "region" name="departure">
    <view wx:if="{{region}}">
      {{region[0]}}，{{region[1]}}，{{region[2]}}
     </view>
     <view wx:else style="color: white;">请选择</view>
   </picker>
</view>

<view class='sex'>
    <text>来程交通方式</text>
    <picker bindchange="bindtransChange" value="{{ trans }}" range="{{transArr}}" name="trans">
    <view wx:if="{{ trans }}">
         {{ transArr[trans] }}
     </view>
     <view wx:else style="color: white;">请选择</view>
   </picker>
  </view>
</view>

<button form-type='submit' class="submit" style="margin-bottom: 100rpx; margin-top: 50rpx;">提交</button>
